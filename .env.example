# =============================================================================
# AI Receptionist V2 – environment variables
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# Google AI Studio API key for Gemini Live (native audio).
# Get it at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio Account SID (starts with "AC...").
# Console: https://console.twilio.com/ → Account → Account SID
TWILIO_ACCOUNT_SID=your_account_sid_here

# Twilio Auth Token (keep secret).
# Console: https://console.twilio.com/ → Account → Auth Token
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio voice/SMS number in E.164 format (sends booking confirmations).
# Console: https://console.twilio.com/ → Phone Numbers
TWILIO_PHONE_NUMBER=+15551234567

# Public WebSocket URL Twilio opens for Media Streams (same host as /voice).
# Local: run `ngrok http 5000`, then use the ngrok host with wss + /media-stream.
# Example: wss://abc123.ngrok-free.app/media-stream
MEDIA_STREAM_URL=wss://your-ngrok-or-host.example/media-stream

# Flask session secret. Use a long random string in production.
# Also used to authorize GET /metrics?key=<this_value>
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_flask_secret_key_here

# Gmail SMTP for advisor booking emails (to ajkimx333@gmail.com).
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
EMAIL_APP_PASSWORD=your_gmail_app_password_here
# Optional sender address (defaults to ajkimx333@gmail.com)
# EMAIL_FROM=ajkimx333@gmail.com
